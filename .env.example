# Public values only. Never put a Runpod key or any other secret here:
# everything VITE_* is compiled into the public JavaScript bundle.

# Cloudflare Worker proxy (no trailing slash). Empty = Analyze/Generate disabled, Presets still work.
VITE_API_BASE=https://bcot-proxy.YOUR_SUBDOMAIN.workers.dev
# Turnstile *site* key (public). Leave empty if the proxy has no TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=
